# Database (get a free Postgres URL from Neon, Supabase, or Railway)
DATABASE_URL="postgresql://username:password@host:5432/ai_twin"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Google OAuth (create at console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Anthropic (get at console.anthropic.com)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Paystack (paystack.com — get keys from Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY="sk_live_your-secret-key"
PAYSTACK_PUBLIC_KEY="pk_live_your-public-key"
# Create a monthly plan in Paystack dashboard at $29/month, paste the plan code here
PAYSTACK_PRO_PLAN_CODE="PLN_xxxxxxxxxxxxxxx"

# Public URL of your site (used for payment return/cancel/notify URLs)
NEXTAUTH_URL="http://localhost:3000"

# ElevenLabs (voice cloning + TTS)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Cloudflare R2 (file storage — photos and voice recordings)
# Create bucket at dash.cloudflare.com → R2 → Create bucket
# Create API token at R2 → Manage R2 API tokens → Object Read & Write
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="ownmytwin-media"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Cron job secret — generate with: openssl rand -base64 32
# Used to authenticate POST /api/cron/ai-posts
# Call it from Vercel Cron or any scheduler with: Authorization: Bearer <secret>
CRON_SECRET="your-cron-secret-here"
