# Database (get a free Postgres URL from Neon, Supabase, or Railway)
DATABASE_URL="postgresql://username:password@host:5432/ai_twin"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Google OAuth (create at console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Anthropic (get at console.anthropic.com)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# PayFast (payfast.co.za — get merchant ID and key from your PayFast dashboard)
PAYFAST_MERCHANT_ID="your-merchant-id"
PAYFAST_MERCHANT_KEY="your-merchant-key"
PAYFAST_PASSPHRASE="your-passphrase-if-set"
# Set to "false" to use live PayFast in production; sandbox is used by default
PAYFAST_SANDBOX="true"

# Public URL of your site (used for PayFast return/cancel/notify URLs)
NEXTAUTH_URL="http://localhost:3000"
