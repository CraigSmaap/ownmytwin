generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordHash       String?
  twoFactorEnabled   Boolean @default(false)
  twoFactorSecret    String?
  onboardingComplete Boolean @default(false)
  accountType        String  @default("talent")  // "talent" | "buyer"
  buyerProfile       Json?
  role               String  @default("user")
  publicSlug         String? @unique
  plan               String  @default("free")    // "free" | "pro"
  planExpiresAt      DateTime?
  dateOfBirth        DateTime?
  popiConsent        Boolean   @default(false)
  popiConsentAt      DateTime?

  twin            Twin?
  photos          LikenessPhoto[]
  voiceRecordings VoiceRecording[]
  accounts        Account[]
  sessions        Session[]
  buyerRequests   LicenseRequest[] @relation("BuyerRequests")
  buyerReviews    Review[]         @relation("BuyerReviews")
  apiKeys         ApiKey[]
}

model LikenessPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model VoiceRecording {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  label     String?
  duration  Float?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Twin {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String?
  personality  Json?
  writingStyle Json?
  systemPrompt        String?  @db.Text
  elevenLabsVoiceId   String?
  licensePermissions  Json?
  bio                 String?  @db.Text
  marketplaceVisible  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memories        Memory[]
  messages        Message[]
  licenseRequests LicenseRequest[]
  reviews         Review[]
}

model Memory {
  id        String   @id @default(cuid())
  twinId    String
  twin      Twin     @relation(fields: [twinId], references: [id], onDelete: Cascade)
  title      String
  content    String   @db.Text
  category   String?
  visibility String   @default("twin_only")
  importance String   @default("medium")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([twinId])
}

model Message {
  id        String   @id @default(cuid())
  twinId    String
  twin      Twin     @relation(fields: [twinId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  platform  String?
  createdAt DateTime @default(now())

  @@index([twinId])
}

model LicenseRequest {
  id         String   @id @default(cuid())
  twinId     String
  twin       Twin     @relation(fields: [twinId], references: [id], onDelete: Cascade)
  buyerId    String?
  buyer      User?    @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName  String
  buyerEmail String
  company    String?
  usageType  String
  message    String   @db.Text
  status       String    @default("pending")
  responseNote String?   @db.Text
  respondedAt  DateTime?
  agreedPrice  Int       @default(0)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  review       Review?

  @@index([twinId])
  @@index([buyerId])
}

model Review {
  id               String         @id @default(cuid())
  twinId           String
  twin             Twin           @relation(fields: [twinId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User           @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  licenseRequestId String         @unique
  licenseRequest   LicenseRequest @relation(fields: [licenseRequestId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([twinId])
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  prefix      String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@index([identifier])
}
